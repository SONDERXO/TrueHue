# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Data – do not commit large datasets
data/raw/*
data/processed/*
data/train/*
data/validation/*
data/test/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/train/.gitkeep
!data/validation/.gitkeep
!data/test/.gitkeep

# Models – ignore binaries, keep structure
models/*.onnx
models/*.pkl
models/*.joblib
models/face_detector/
models/face_landmarker/
!models/.gitkeep

# Outputs – ignore generated artefacts
outputs/corrected_images/*
outputs/masks/*
outputs/figures/*
outputs/metrics/*
outputs/pilot_face_crops/
outputs/pilot_masks/
outputs/pilot_visualizations/
!outputs/.gitkeep
!outputs/corrected_images/.gitkeep
!outputs/masks/.gitkeep
!outputs/figures/.gitkeep
!outputs/metrics/.gitkeep

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Android / Gradle
*.iml
.gradle
local.properties
*.apk
*.aab
*.dex
*.class
