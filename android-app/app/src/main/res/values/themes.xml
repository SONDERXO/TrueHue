<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme for the app (applied by Android before Compose takes over).
        Parent is the platform theme - we do NOT depend on AppCompat because the UI
        is 100% Jetpack Compose. Compose then applies the real colors via
        ui/theme/Theme.kt (SkinToneCorrectionTheme).
    -->
    <style name="Theme.SkinToneCorrection" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Theme.SkinToneCorrection.Launch" parent="Theme.SkinToneCorrection">
        <item name="android:windowBackground">@drawable/truehue_launch_background</item>
        <item name="android:statusBarColor">@color/truehue_teal</item>
        <item name="android:navigationBarColor">@color/truehue_teal</item>
    </style>
</resources>
